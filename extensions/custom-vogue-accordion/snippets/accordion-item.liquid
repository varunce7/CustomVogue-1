<div class="cv-accordion-item">
  <button
    class="cv-accordion-trigger"
    aria-expanded="false"
    aria-controls="cv-panel-{{ block_id }}-{{ index }}"
    data-cv-trigger
    data-field-id="{{ field.id }}"
    data-field-title="{{ field.title | escape }}"
  >
    <span
      class="cv-accordion-title{% if field.titleFont != blank %} ql-font-{{ field.titleFont }}{% endif %}"
      style="font-size: {{ title_font_size }}px;"
    >
      {{- field.title | escape -}}
    </span>
    <span class="cv-accordion-icon cv-icon-{{ icon_style }}" aria-hidden="true">
      {% if icon_style == 'plus' %}
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <line x1="12" y1="4" x2="12" y2="20" class="cv-plus-vertical"/>
          <line x1="4" y1="12" x2="20" y2="12"/>
        </svg>
      {% else %}
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="4,8 12,17 20,8"/>
        </svg>
      {% endif %}
    </span>
  </button>
  <div
    id="cv-panel-{{ block_id }}-{{ index }}"
    class="cv-accordion-panel"
    data-cv-panel
  >
    <div class="cv-accordion-inner">
      <div
        class="cv-accordion-content{% if field.titleFont != blank %} ql-font-{{ field.titleFont }}{% endif %}"
        style="font-size: {{ font_size }}px;"
      >{{ field.content }}</div>
    </div>
  </div>
</div>
